# One KEY=value per line.  This file is read three ways (docker --env-file,
# systemd EnvironmentFile, shell sourcing) and docker's reader is the strict
# one: it keeps surrounding quotes literal and does not start a comment
# mid-line.  So: comments on their own line, no trailing ' # note', and the
# daemon unwraps one matched pair of outer quotes for you.

# Leave DEVICE_ADDRESS unset to auto-discover the sensor by BLE name + reading
# signature (recommended — Govee H5075 BLE MACs change when the device is
# re-paired or power-cycled). Set it only to pin a specific MAC.
# DEVICE_ADDRESS=AA:BB:CC:DD:EE:FF

# Govee H5075 BLE names look like 'GVH5075_105F' (model token first, not the
# word 'Govee'), so auto-discovery matches the model string. Lower-case, only
# letters and digits are compared; leave as default unless your device differs.
DEVICE_NAME_MATCH=h5075

# HA-friendly display name (shown in Home Assistant, not used to match).
# No quotes needed: docker --env-file takes the value verbatim, and the daemon
# strips one matched pair of outer quotes if a shell-style loader left them.
DEVICE_NAME=Govee H5075

# Stable slug for HA unique_id + topic paths. Default derives from the last
# hex digits of DEVICE_ADDRESS, which CHANGE when the sensor is re-paired —
# set it explicitly so Home Assistant keeps one device instead of adding one.
DEVICE_SLUG=govee_h5075

# Mosquitto on your LAN. Use a dedicated account/password; never commit a
# filled-in copy. Changing these needs a fresh `docker run` — --env-file
# values are baked in when the container is created.
# MQTT_PORT is the broker's raw MQTT socket (Mosquitto default 1883) — NOT
# HA's web/app port and NOT a wss:// websocket endpoint.
MQTT_HOST=10.0.0.1
MQTT_PORT=1883
# 'raw' = plain MQTT socket (Mosquitto 1883); 'ws' = websocket endpoint
# (HA's built-in MQTT integration: ws 9001, wss 9443). Anything else is
# rejected at startup.
MQTT_TRANSPORT=raw
MQTT_USERNAME=change-me
MQTT_PASSWORD=replace-with-a-long-random-password

MQTT_BASE_TOPIC=sensors/govee_h5075
MQTT_DISCOVERY_PREFIX=homeassistant

# For wss:// or https brokers set true and supply the matching cert paths.
# MQTT_TLS_ENABLED=false
# MQTT_TLS_CA_CERT=/etc/ssl/certs/ca-certificates.crt
# MQTT_TLS_CLIENT_CERT=
# MQTT_TLS_CLIENT_KEY=
# MQTT_TLS_INSECURE=false

# Polling and retry behavior. Values are seconds.
POLL_INTERVAL=600
SCAN_WINDOW=30
RETRIES=4
RETRY_DELAY=5
# Hold-off between scan attempts; BlueZ needs the sensor to redisplay its
# announcement after the advertisement monitor reopens.
SCAN_BACKOFF=2
# DEBUG | INFO | WARNING | ERROR | CRITICAL (invalid values are rejected at
# startup, and so is anything that does not exactly match one of them).
LOG_LEVEL=INFO
